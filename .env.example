# Public canonical production origin; no path or query.
VITE_PUBLIC_SITE_URL=https://researchstarterlab.com

# Public browser configuration only. Both values must refer to the same project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only variables. Never prefix these secrets with VITE_.
# Connect a PRIVATE Vercel Blob store to this project.
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
# Use an address on your Resend-verified sending domain, e.g.:
# FEEDBACK_FROM_EMAIL=Research Starter Lab Feedback <feedback@your-verified-domain.com>
FEEDBACK_FROM_EMAIL=
