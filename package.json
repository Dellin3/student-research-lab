{
  "name": "student-research-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run prerender",
    "build:client": "vite build",
    "check:seo": "node scripts/check-seo.mjs",
    "check:prerender": "node scripts/check-prerender.mjs",
    "check:question-builder": "node scripts/check-question-builder.mjs",
    "check:question-grammar": "node scripts/check-question-grammar.mjs",
    "check:research-record": "node scripts/check-research-record.mjs",
    "check:content-boundary": "node scripts/check-content-boundary.mjs",
    "check:topic-narrowing": "node scripts/check-topic-narrowing.mjs",
    "check:master-sprint-r1": "npm run check:question-builder && npm run check:question-grammar && npm run check:research-record && npm run check:content-boundary",
    "check:master-sprint-r2": "npm run check:master-sprint-r1 && npm run check:topic-narrowing",
    "qa:browser": "playwright test",
    "qa:r1": "playwright test tests/e2e/r1.spec.js",
    "qa:r2": "playwright test tests/e2e/r2.spec.js",
    "lint": "eslint .",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
