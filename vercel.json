{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "student-research-lab-theta\\.vercel\\.app" }],
      "missing": [
        { "type": "query", "key": "code" },
        { "type": "query", "key": "error" },
        { "type": "query", "key": "error_code" },
        { "type": "query", "key": "error_description" },
        { "type": "query", "key": "mode" }
      ],
      "destination": "https://researchstarterlab.com/",
      "permanent": true
    },
    {
      "source": "/start-here",
      "has": [{ "type": "host", "value": "student-research-lab-theta\\.vercel\\.app" }],
      "destination": "https://researchstarterlab.com/start-here",
      "permanent": true
    },
    {
      "source": "/resources",
      "has": [{ "type": "host", "value": "student-research-lab-theta\\.vercel\\.app" }],
      "destination": "https://researchstarterlab.com/resources",
      "permanent": true
    },
    {
      "source": "/guides/:path*",
      "has": [{ "type": "host", "value": "student-research-lab-theta\\.vercel\\.app" }],
      "destination": "https://researchstarterlab.com/guides/:path*",
      "permanent": true
    },
    {
      "source": "/learn",
      "destination": "/start-here",
      "statusCode": 301
    },
    {
      "source": "/tools",
      "destination": "/start-here",
      "statusCode": 301
    },
    {
      "source": "/topic-narrowing",
      "destination": "/start-here",
      "statusCode": 301
    },
    {
      "source": "/find-a-direction",
      "destination": "/start-here",
      "statusCode": 301
    },
    {
      "source": "/research-workflow",
      "destination": "/start-here",
      "statusCode": 301
    },
    {
      "source": "/research-question-builder",
      "destination": "/start-here",
      "statusCode": 301
    },
    {
      "source": "/investigation-planner",
      "destination": "/start-here",
      "statusCode": 301
    },
    {
      "source": "/ai-literature",
      "destination": "/resources#sources",
      "statusCode": 301
    },
    {
      "source": "/build-a-project",
      "destination": "/start-here",
      "statusCode": 301
    },
    {
      "source": "/outreach",
      "destination": "/resources#mentors",
      "statusCode": 301
    },
    {
      "source": "/case-studies",
      "destination": "/start-here#example",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/guides/research-without-a-mentor",
      "destination": "/guides/research-without-a-mentor/index.html"
    },
    {
      "source": "/guides/read-your-first-paper",
      "destination": "/guides/read-your-first-paper/index.html"
    },
    {
      "source": "/start-here",
      "destination": "/start-here/index.html"
    },
    {
      "source": "/resources",
      "destination": "/resources/index.html"
    },
    {
      "source": "/worksheet",
      "destination": "/worksheet/index.html"
    },
    {
      "source": "/account",
      "destination": "/account/index.html"
    },
    {
      "source": "/my-research",
      "destination": "/my-research/index.html"
    },
    {
      "source": "/feedback",
      "destination": "/feedback/index.html"
    }
  ],
  "headers": [
    {
      "source": "/account",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/my-research",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/feedback.js": {
      "maxDuration": 30
    }
  }
}
